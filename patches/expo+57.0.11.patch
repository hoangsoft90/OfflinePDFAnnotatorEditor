+if (typeof AbortSignal === 'undefined') {
+  try {
+    // @ts-expect-error: `require` is injected by the bundler.
+    const abortControllerModule = require('abort-controller');
+    install('AbortController', () => abortControllerModule.AbortController);
+    install('AbortSignal', () => abortControllerModule.AbortSignal);
+  } catch {
+    // Leave the globals undefined; an actual `fetch` call would then surface
+    // a clearer error later instead of crashing at bundle load.
+  }
+}
+if (typeof AbortSignal !== 'undefined') {
+  installAbortSignalPatch(AbortSignal);
+}
 
